@model IReadOnlyList<CodeRoom.Web.Models.Quiz>
@{
    ViewData["Title"] = "Manage Quizzes";
}

<section class="page-shell">
    <div class="container">
        <div class="admin-crud-header">
            <div>
                <span class="eyebrow">QUIZZES</span>
                <h1 class="page-title">Manage quizzes</h1>
            </div>
            <a class="btn btn-primary" asp-action="Create">+ New quiz</a>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }

        <div class="content-panel">
            <table class="data-table">
                <thead><tr><th>Title</th><th>Course</th><th>Questions</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td>@q.Title</td>
                        <td>@q.Course?.Title</td>
                        <td>@q.Questions.Count</td>
                        <td class="row-actions">
                            <a class="btn btn-secondary btn-sm" asp-action="Manage" asp-route-id="@q.Id">Questions</a>
                            <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@q.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@q.Id" method="post" onsubmit="return confirm('Delete this quiz and all its questions?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4">No quizzes yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
