@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="page-shell">
    <div class="container">
        <span class="eyebrow">ADMINISTRATION</span>
        <h1 class="page-title">Code-Room management</h1>
        <p class="page-intro">Manage learning content and monitor platform activity.</p>

        <div class="dashboard-stats">
            <div class="stat-card"><strong>8</strong><span>Catalogue courses</span></div>
            <div class="stat-card"><strong>80</strong><span>Planned lessons</span></div>
            <div class="stat-card"><strong>—</strong><span>Live student records</span></div>
        </div>

        <div class="admin-grid">
            <div class="content-panel"><h2>Courses</h2><p>Create, update and publish courses.</p><button class="btn btn-secondary" type="button">Manage courses</button></div>
            <div class="content-panel"><h2>Lessons</h2><p>Organise lesson content and resources.</p><button class="btn btn-secondary" type="button">Manage lessons</button></div>
            <div class="content-panel"><h2>Quizzes</h2><p>Create questions and review assessments.</p><button class="btn btn-secondary" type="button">Manage quizzes</button></div>
        </div>
    </div>
</section>
