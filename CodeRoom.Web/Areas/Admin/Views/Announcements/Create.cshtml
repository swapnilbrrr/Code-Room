@model CodeRoom.Web.Models.Announcement
@{
    ViewData["Title"] = "New Announcement";
}

<section class="page-shell">
    <div class="container narrow">
        <span class="eyebrow">ANNOUNCEMENTS</span>
        <h1 class="page-title">New announcement</h1>
        <div class="content-panel">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <partial name="_Form" model="Model" />
                <div class="form-actions">
                    <a class="btn btn-ghost" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary" type="submit">Create announcement</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
