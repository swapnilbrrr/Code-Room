@model CodeRoom.Web.Models.Lesson
@{
    var courses = ViewBag.Courses as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<div class="form-grid">
    <label class="form-field">Course
        <select class="input" asp-for="CourseId" asp-items="courses">
            <option value="">Select a course</option>
        </select>
        <span asp-validation-for="CourseId" class="field-error"></span>
    </label>
    <label class="form-field">Order
        <input class="input" asp-for="Order" type="number" min="1" />
        <span asp-validation-for="Order" class="field-error"></span>
    </label>
    <label class="form-field form-field-wide">Title
        <input class="input" asp-for="Title" />
        <span asp-validation-for="Title" class="field-error"></span>
    </label>
    <label class="form-field form-field-wide">Summary
        <input class="input" asp-for="Summary" placeholder="A one-line learner-friendly overview." />
        <span asp-validation-for="Summary" class="field-error"></span>
    </label>
    <label class="form-field">Content type
        <select class="input" asp-for="ContentType">
            <option>Reading</option>
            <option>Video</option>
            <option>Audio</option>
            <option>Challenge</option>
            <option>Assessment</option>
            <option>Final Exam</option>
        </select>
    </label>
    <label class="form-field">Duration (minutes)
        <input class="input" asp-for="DurationMinutes" type="number" min="1" />
        <span asp-validation-for="DurationMinutes" class="field-error"></span>
    </label>
    <label class="form-field form-field-wide">Content
        <textarea class="input" asp-for="Content" rows="9"></textarea>
        <span asp-validation-for="Content" class="field-error"></span>
    </label>
    <label class="form-field">Video URL (YouTube embed supported)
        <input class="input" asp-for="VideoUrl" type="url" />
        <span asp-validation-for="VideoUrl" class="field-error"></span>
    </label>
    <label class="form-field">Audio URL (optional)
        <input class="input" asp-for="AudioUrl" type="url" />
        <span asp-validation-for="AudioUrl" class="field-error"></span>
    </label>
    <label class="form-field form-field-wide">Supporting resource URL
        <input class="input" asp-for="ResourceUrl" type="url" />
        <span asp-validation-for="ResourceUrl" class="field-error"></span>
    </label>
    <label class="checkbox-row">
        <input asp-for="IsPublished" type="checkbox" /> <span>Published</span>
    </label>
</div>
