@model IReadOnlyList<CodeRoom.Web.Models.Course>
@{
    ViewData["Title"] = "Manage Courses";
}

<section class="page-shell">
    <div class="container">
        <div class="admin-crud-header">
            <div>
                <span class="eyebrow">COURSES</span>
                <h1 class="page-title">Manage courses</h1>
            </div>
            <a class="btn btn-primary" asp-action="Create">+ New course</a>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }

        <div class="content-panel">
            <table class="data-table">
                <thead><tr><th>Title</th><th>Category</th><th>Level</th><th>Lessons</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Title</td>
                        <td>@c.Category</td>
                        <td>@c.Level</td>
                        <td>@c.Lessons.Count</td>
                        <td>@(c.IsPublished ? "Published" : "Draft")</td>
                        <td class="row-actions">
                            <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Delete this course and its lessons?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6">No courses yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
