@model CodeRoom.Web.ViewModels.Dashboard.PersonalDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var levelWidth = Math.Clamp((Model.LevelProgress / 250.0) * 100.0, 0, 100);
}

<section class="page-shell dashboard-page">
    <div class="container">
        <div class="dashboard-hero">
            <div>
                <span class="eyebrow">PERSONAL DASHBOARD</span>
                <h1 class="page-title">Welcome back, @Model.FullName.Split(' ')[0].</h1>
                <p class="page-intro">Pick up where you left off, keep your streak alive and explore your next skill.</p>
            </div>
            <div class="dashboard-identity">
                <span>@@@Model.Username</span>
                <strong>Student</strong>
            </div>
        </div>

        <div class="dashboard-xp-card">
            <div>
                <span class="eyebrow">LEVEL @Model.Level</span>
                <strong>@Model.Xp XP</strong>
            </div>
            <div class="dashboard-xp-progress">
                <div class="xp-bar"><span style="width:@levelWidth.ToString("0")%"></span></div>
                <small>@Model.LevelProgress / 250 XP to next level</small>
            </div>
            <a class="text-link" asp-controller="Profile" asp-action="Index">View profile →</a>
        </div>

        <div class="dashboard-stat-grid">
            <article class="dashboard-stat"><span>Courses</span><strong>@Model.CoursesEnrolled</strong><small>paths started</small></article>
            <article class="dashboard-stat"><span>Lessons</span><strong>@Model.LessonsCompleted</strong><small>completed</small></article>
            <article class="dashboard-stat"><span>Quiz average</span><strong>@Model.QuizAverage%</strong><small>across attempts</small></article>
            <article class="dashboard-stat"><span>Streak</span><strong>🔥 @Model.LearningStreak</strong><small>days learning</small></article>
            <article class="dashboard-stat"><span>Certificates</span><strong>@Model.CertificateCount</strong><small>earned</small></article>
        </div>

        <div class="dashboard-main-grid">
            <section class="dashboard-panel dashboard-courses-panel">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">CONTINUE LEARNING</span>
                        <h2>Pick up where you left off</h2>
                    </div>
                    <a class="text-link" asp-controller="Courses" asp-action="Index">Explore all →</a>
                </div>

                @if (Model.Courses.Count == 0)
                {
                    <div class="empty-state compact">
                        <div class="empty-state-icon">🧭</div>
                        <h3>Your learning path is waiting.</h3>
                        <p>Choose a course and your dashboard will start tracking your journey.</p>
                        <a class="btn btn-primary" asp-controller="Courses" asp-action="Index">Explore courses</a>
                    </div>
                }
                else
                {
                    <div class="dashboard-course-list">
                        @foreach (var item in Model.Courses)
                        {
                            var percent = item.TotalLessons == 0 ? 0 : (int)Math.Round(item.CompletedLessons * 100.0 / item.TotalLessons);
                            <article class="dashboard-course-card">
                                <div>
                                    <span class="course-card-meta">@item.Course.Category · @item.Course.Level</span>
                                    <h3>@item.Course.Title</h3>
                                    <p>@item.CompletedLessons of @item.TotalLessons lessons completed</p>
                                    <div class="progress-track"><span style="width:@percent%"></span></div>
                                </div>
                                <a class="btn btn-secondary" asp-controller="Lessons" asp-action="Index" asp-route-id="@item.Course.Id">Continue</a>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="dashboard-panel dashboard-recommendations">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">FOR YOU</span>
                        <h2>Recommended next</h2>
                    </div>
                </div>

                @if (Model.RecommendedCourses.Count == 0)
                {
                    <p class="profile-empty">Complete a course and we'll keep building your next-step suggestions.</p>
                }
                else
                {
                    <div class="recommendation-list">
                        @foreach (var item in Model.RecommendedCourses)
                        {
                            <a class="recommendation-card" asp-controller="Courses" asp-action="Details" asp-route-id="@item.Course.Id">
                                <span class="recommendation-icon">@(item.Course.IsCertification ? "🎓" : "✦")</span>
                                <span>
                                    <strong>@item.Course.Title</strong>
                                    <small>@item.Reason</small>
                                </span>
                                <span>→</span>
                            </a>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="dashboard-main-grid">
            <section class="dashboard-panel">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">ACTIVITY</span>
                        <h2>Your learning rhythm</h2>
                    </div>
                    <span class="profile-muted">365 days</span>
                </div>
                <div class="activity-grid dashboard-heatmap" aria-label="Learning activity calendar">
                    @foreach (var day in Model.ActivityDays)
                    {
                        <span class="activity-cell level-@day.Level" title="@day.Date.ToString("dd MMM yyyy"): @day.Count activities"></span>
                    }
                </div>
                <div class="activity-legend">
                    <span>Less</span><i class="activity-level level-0"></i><i class="activity-level level-1"></i><i class="activity-level level-2"></i><i class="activity-level level-3"></i><i class="activity-level level-4"></i><span>More</span>
                </div>
            </section>

            <section class="dashboard-panel">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">RECENT</span>
                        <h2>Learning activity</h2>
                    </div>
                </div>
                @if (Model.RecentActivity.Count == 0)
                {
                    <p class="profile-empty">Complete a lesson or quiz to start your activity feed.</p>
                }
                else
                {
                    <div class="activity-list">
                        @foreach (var item in Model.RecentActivity)
                        {
                            <div class="activity-item">
                                <span class="activity-dot"></span>
                                <div><strong>@item.Description</strong><time>@item.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</time></div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="dashboard-main-grid">
            <section class="dashboard-panel">
                <div class="panel-heading">
                    <div><span class="eyebrow">ASSESSMENTS</span><h2>Quiz history</h2></div>
                </div>
                @if (Model.RecentAttempts.Count == 0)
                {
                    <p class="profile-empty">No assessments yet. Take your first quiz from a course.</p>
                }
                else
                {
                    <div class="attempt-list">
                        @foreach (var attempt in Model.RecentAttempts)
                        {
                            var percent = attempt.TotalQuestions == 0 ? 0 : (int)Math.Round(attempt.Score * 100.0 / attempt.TotalQuestions);
                            <div class="attempt-row">
                                <div><strong>@attempt.Quiz.Title</strong><small>@attempt.AttemptedAt.ToLocalTime().ToString("dd MMM yyyy")</small></div>
                                <span class="score-pill">@percent%</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="dashboard-panel">
                <div class="panel-heading">
                    <div><span class="eyebrow">NEWS</span><h2>Announcements</h2></div>
                </div>
                <div class="announcement-list">
                    @foreach (var announcement in Model.Announcements)
                    {
                        <article class="announcement-card">
                            <strong>@announcement.Title</strong>
                            <p>@announcement.Message</p>
                            <time>@announcement.PublishedAt.ToLocalTime().ToString("dd MMM yyyy")</time>
                        </article>
                    }
                </div>
            </section>
        </div>

        <div class="dashboard-footer-actions">
            <a class="btn btn-secondary" asp-controller="Challenges" asp-action="Index" asp-route-id="1">Practice challenges</a>
            <a class="btn btn-secondary" asp-controller="Certificates" asp-action="Index">Certificates</a>
        </div>
    </div>
</section>
