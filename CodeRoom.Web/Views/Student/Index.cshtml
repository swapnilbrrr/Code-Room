@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-shell">
    <div class="container">
        <span class="eyebrow">STUDENT DASHBOARD</span>
        <h1 class="page-title">Your learning dashboard</h1>
        <p class="page-intro">A single place for enrolled courses, lesson progress and quiz results.</p>

        <div class="dashboard-stats">
            <div class="stat-card"><strong>3</strong><span>Example enrolments</span></div>
            <div class="stat-card"><strong>18</strong><span>Example lessons completed</span></div>
            <div class="stat-card"><strong>82%</strong><span>Example quiz average</span></div>
        </div>

        <div class="content-panel">
            <div class="panel-heading"><h2>Continue learning</h2><a asp-controller="Courses" asp-action="Index">Browse courses</a></div>

            <div class="course-progress-row">
                <div><strong>ASP.NET Core MVC</strong><span>4 of 10 lessons</span></div>
                <div class="progress-track"><span style="width: 40%"></span></div>
            </div>

            <div class="course-progress-row">
                <div><strong>Cybersecurity Foundations</strong><span>6 of 10 lessons</span></div>
                <div class="progress-track"><span style="width: 60%"></span></div>
            </div>

            <div class="course-progress-row">
                <div><strong>Networking Fundamentals</strong><span>3 of 10 lessons</span></div>
                <div class="progress-track"><span style="width: 30%"></span></div>
            </div>
        </div>
    </div>
</section>
