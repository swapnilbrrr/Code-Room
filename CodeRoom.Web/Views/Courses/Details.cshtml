@model CodeRoom.Web.ViewModels.CoursePreviewViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-shell">
    <div class="container course-detail">
        <span class="eyebrow">@Model.Category.ToUpperInvariant()</span>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-intro">@Model.Summary</p>

        <div class="detail-grid">
            <div class="content-panel">
                <h2>What you'll learn</h2>
                <ul class="check-list">
                    @foreach (var outcome in Model.LearningOutcomes)
                    {
                        <li>@outcome</li>
                    }
                </ul>
            </div>

            <aside class="content-panel course-start-card">
                <span class="level-pill">@Model.Level</span>
                <strong>@Model.Lessons.Length lessons</strong>
                <span>Structured learning path</span>
                <a class="btn btn-primary" asp-controller="Lessons" asp-action="Index" asp-route-id="@Model.Id">Start learning</a>
            </aside>
        </div>

        <div class="course-outline">
            <div class="section-heading">
                <span class="eyebrow">COURSE OUTLINE</span>
                <h2>Work through the lessons in order.</h2>
                <p>Each lesson will become database-backed content with resources, completion tracking and assessment links.</p>
            </div>

            <ol class="lesson-outline">
                @for (var i = 0; i < Model.Lessons.Length; i++)
                {
                    <li>
                        <span>@((i + 1).ToString("D2"))</span>
                        <strong>@Model.Lessons[i]</strong>
                    </li>
                }
            </ol>
        </div>
    </div>
</section>
