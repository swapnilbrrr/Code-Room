@model CodeRoom.Web.ViewModels.Profile.ProfileSettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<section class="page-shell settings-page">
    <div class="container settings-shell">
        <aside class="settings-sidebar" aria-label="Settings sections">
            <span class="eyebrow">ACCOUNT</span>
            <a href="#profile" class="settings-tab is-active">Profile</a>
            <a href="#account" class="settings-tab">Account</a>
            <a href="#security" class="settings-tab">Security</a>
            <a href="#notifications" class="settings-tab">Notifications</a>
            <a href="#appearance" class="settings-tab">Appearance</a>
        </aside>

        <div class="settings-content">
            <div class="settings-heading">
                <div>
                    <span class="eyebrow">SETTINGS</span>
                    <h1 class="page-title">Account settings</h1>
                    <p class="page-intro">Control your Code-Room identity, security and learning experience.</p>
                </div>
                <a class="btn btn-secondary" asp-action="Index">View profile</a>
            </div>

            <form asp-action="Settings" method="post" enctype="multipart/form-data" id="account-settings-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <section class="settings-card settings-section-card" id="profile">
                    <div class="settings-card-heading">
                        <div>
                            <h2>Profile</h2>
                            <p>These details are shown on your learning identity.</p>
                        </div>
                    </div>

                    <div class="settings-profile-preview">
                        <div class="profile-avatar profile-avatar-large">
                            @Model.FullName.Trim().FirstOrDefault()
                        </div>
                        <div>
                            <strong>@Model.FullName</strong>
                            <span>@@@Model.Username</span>
                        </div>
                    </div>

                    <div class="form-grid">
                        <label>Full name
                            <input class="input" asp-for="FullName" autocomplete="name" />
                            <span asp-validation-for="FullName" class="field-error"></span>
                        </label>

                        <label>Username
                            <input class="input" asp-for="Username" autocomplete="username" />
                            <span asp-validation-for="Username" class="field-error"></span>
                        </label>

                        <label class="form-span-2">Bio
                            <textarea class="input settings-textarea" asp-for="Bio" rows="4" maxlength="500" placeholder="What are you learning right now?"></textarea>
                            <span asp-validation-for="Bio" class="field-error"></span>
                        </label>

                        <label class="form-field">Upload avatar
                            <input class="input" asp-for="AvatarFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            <small class="settings-help">JPG, PNG or WebP · max 2 MB.</small>
                            <span asp-validation-for="AvatarFile" class="field-error"></span>
                        </label>
                        <label class="form-field">Avatar URL
                            <input class="input" asp-for="AvatarUrl" type="url" placeholder="https://..." />
                            <small class="settings-help">Optional remote image. Upload takes priority.</small>
                            <span asp-validation-for="AvatarUrl" class="field-error"></span>
                        </label>
                    </div>
                </section>

                <section class="settings-card settings-section-card" id="account">
                    <div class="settings-card-heading">
                        <div>
                            <h2>Account</h2>
                            <p>Your sign-in identity and profile visibility.</p>
                        </div>
                    </div>
                    <div class="form-grid">
                        <label>Email address
                            <input class="input" asp-for="Email" type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </label>

                        <label>Profile visibility
                            <select class="input" asp-for="ProfileVisibility">
                                <option value="Public">Public</option>
                                <option value="Members">Code-Room members</option>
                            </select>
                        </label>
                    </div>
                </section>

                <section class="settings-card settings-section-card" id="security">
                    <div class="settings-card-heading">
                        <div>
                            <h2>Security</h2>
                            <p>Change your password without leaving the settings area.</p>
                        </div>
                    </div>
                    <div class="form-grid">
                        <label>Current password
                            <div class="password-field">
                                <input class="input" asp-for="CurrentPassword" autocomplete="current-password" />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="Show current password"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="field-error"></span>
                        </label>

                        <label>New password
                            <div class="password-field">
                                <input class="input" asp-for="NewPassword" autocomplete="new-password" />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="Show new password"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></button>
                            </div>
                            <span asp-validation-for="NewPassword" class="field-error"></span>
                        </label>

                        <label>Confirm new password
                            <div class="password-field">
                                <input class="input" asp-for="ConfirmNewPassword" autocomplete="new-password" />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password confirmation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
                        </label>
                    </div>
                </section>

                <section class="settings-card settings-section-card" id="notifications">
                    <div class="settings-card-heading">
                        <div>
                            <h2>Notifications</h2>
                            <p>Choose how much activity reaches your account feed.</p>
                        </div>
                    </div>
                    <label class="switch-row">
                        <span>
                            <strong>Activity notifications</strong>
                            <small>Show achievements, streaks, course and assessment updates in the notification centre.</small>
                        </span>
                        <input asp-for="EmailNotificationsEnabled" type="checkbox" class="switch-input" />
                    </label>
                </section>

                <section class="settings-card settings-section-card" id="appearance">
                    <div class="settings-card-heading">
                        <div>
                            <h2>Appearance</h2>
                            <p>Choose the visual mode used by Code-Room.</p>
                        </div>
                    </div>
                    <div class="segmented-control" data-theme-setting>
                        <label><input type="radio" asp-for="ThemePreference" value="light" /> <span>Light</span></label>
                        <label><input type="radio" asp-for="ThemePreference" value="dark" /> <span>Dark</span></label>
                        <label><input type="radio" asp-for="ThemePreference" value="system" /> <span>System</span></label>
                    </div>
                </section>

                <div class="settings-savebar">
                    <span>Changes are stored in your Code-Room account.</span>
                    <button class="btn btn-primary" type="submit">Save settings</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-theme-setting] input').forEach(input => {
            input.addEventListener('change', () => {
                if (input.checked) {
                    localStorage.setItem('code-room-theme', input.value === 'system' ? 'light' : input.value);
                    document.documentElement.dataset.theme = input.value === 'system' ? 'light' : input.value;
                }
            });
        });
    </script>
}
