@model CodeRoom.Web.ViewModels.Profile.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "C" : Model.FullName.Trim()[0].ToString().ToUpperInvariant();
    var levelWidth = Math.Clamp((Model.LevelProgress / 250.0) * 100.0, 0, 100);
}

<section class="page-shell profile-page">
    <div class="container">
        <div class="profile-hero profile-hero-enhanced">
            <div class="profile-identity">
                @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                {
                    <img class="profile-avatar profile-avatar-large" src="@Model.AvatarUrl" alt="@Model.FullName avatar" />
                }
                else
                {
                    <div class="profile-avatar profile-avatar-large">@initial</div>
                }
                <div>
                    <span class="eyebrow">CODE-ROOM PROFILE</span>
                    <h1 class="page-title">@Model.FullName</h1>
                    <p class="profile-handle">@@@Model.Username · @Model.RoleLabel</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Bio))
                    {
                        <p class="profile-bio">@Model.Bio</p>
                    }
                    else
                    {
                        <p class="profile-bio">Build your learning identity as you learn, practise and grow.</p>
                    }
                </div>
            </div>
            <div class="profile-actions">
                <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="btn btn-primary" asp-controller="Profile" asp-action="Settings">Edit profile</a>
            </div>
        </div>

        <div class="xp-profile-card">
            <div>
                <span class="eyebrow">LEVEL @Model.Level</span>
                <h2>@Model.Xp XP</h2>
                <p>@(250 - Model.LevelProgress) XP until your next level</p>
            </div>
            <div class="xp-bar-wrap">
                <div class="xp-bar"><span style="width:@levelWidth.ToString("0")%"></span></div>
                <div class="xp-bar-labels"><span>Level @Model.Level</span><span>Level @(Model.Level + 1)</span></div>
            </div>
        </div>

        <div class="profile-stat-grid">
            <article class="profile-stat"><strong>@Model.CoursesEnrolled</strong><span>Courses</span></article>
            <article class="profile-stat"><strong>@Model.LessonsCompleted</strong><span>Lessons</span></article>
            <article class="profile-stat"><strong>@Model.QuizAttempts</strong><span>Assessments</span></article>
            <article class="profile-stat"><strong>@Model.LearningStreak</strong><span>Day streak</span></article>
            <article class="profile-stat"><strong>@Model.CertificateCount</strong><span>Certificates</span></article>
        </div>

        <div class="profile-main-grid profile-main-grid-three">
            <section class="profile-panel profile-activity-panel">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">ACTIVITY</span>
                        <h2>Learning history</h2>
                    </div>
                    <span class="profile-muted">Last 365 days</span>
                </div>

                <div class="activity-legend">
                    <span>Less</span>
                    <i class="activity-level level-0"></i>
                    <i class="activity-level level-1"></i>
                    <i class="activity-level level-2"></i>
                    <i class="activity-level level-3"></i>
                    <i class="activity-level level-4"></i>
                    <span>More</span>
                </div>

                <div class="activity-grid" aria-label="Learning activity calendar">
                    @foreach (var day in Model.ActivityDays)
                    {
                        <span class="activity-cell level-@day.Level" title="@day.Date.ToString("dd MMM yyyy"): @day.Count activities"></span>
                    }
                </div>
            </section>

            <section class="profile-panel">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">ACHIEVEMENTS</span>
                        <h2>Unlocked</h2>
                    </div>
                </div>

                @if (Model.Achievements.Count == 0)
                {
                    <p class="profile-empty">Finish lessons, quizzes and challenges to unlock your first badge.</p>
                }
                else
                {
                    <div class="achievement-list">
                        @foreach (var achievement in Model.Achievements)
                        {
                            <div class="achievement-card">
                                <span class="achievement-icon">@achievement.Icon</span>
                                <div>
                                    <strong>@achievement.Name</strong>
                                    <p>@achievement.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="profile-panel">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">RECENT</span>
                        <h2>Recent activity</h2>
                    </div>
                </div>

                @if (Model.RecentActivity.Count == 0)
                {
                    <p class="profile-empty">Your activity will appear here as you start learning.</p>
                }
                else
                {
                    <div class="activity-list">
                        @foreach (var item in Model.RecentActivity)
                        {
                            <div class="activity-item">
                                <span class="activity-dot"></span>
                                <div>
                                    <strong>@item.Description</strong>
                                    <time>@item.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</time>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <section class="profile-panel profile-about">
            <div class="panel-heading">
                <div>
                    <span class="eyebrow">ACCOUNT</span>
                    <h2>Profile details</h2>
                </div>
                <div class="profile-panel-actions">
                    <a class="text-link" asp-controller="Certificates" asp-action="Index">Certificates →</a>
                    <a class="text-link" asp-action="Settings">Settings →</a>
                </div>
            </div>

            <div class="profile-detail-grid">
                <div><span>Email</span><strong>@Model.Email</strong></div>
                <div><span>Username</span><strong>@@@Model.Username</strong></div>
                <div><span>Role</span><strong>@Model.RoleLabel</strong></div>
                <div><span>Overall progress</span><strong>@Model.ProgressPercent% complete</strong></div>
            </div>
        </section>
    </div>
</section>
