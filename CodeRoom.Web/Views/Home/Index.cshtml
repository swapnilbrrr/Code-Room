@{
    ViewData["Title"] = "Learn Technology";
}

<section class="hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <span class="eyebrow">TECHNOLOGY LEARNING PLATFORM</span>
            <h1>Learn technology.<br /><span>Build real skills.</span></h1>
            <p>
                Code-Room brings structured lessons, practical resources, quizzes and progress tracking
                into one simple learning space for students.
            </p>

            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Courses" asp-action="Index">Explore courses</a>
                <a class="text-link" asp-controller="Home" asp-action="About">Learn how Code-Room works <span>→</span></a>
            </div>

            <div class="hero-trust">
                <div>
                    <strong>Structured</strong>
                    <span>Courses and lessons</span>
                </div>
                <div>
                    <strong>Interactive</strong>
                    <span>Quizzes and practice</span>
                </div>
                <div>
                    <strong>Trackable</strong>
                    <span>Progress and results</span>
                </div>
            </div>
        </div>

        <aside class="hero-panel" aria-label="Start learning">
            <span class="panel-kicker">START WITH THE FUNDAMENTALS</span>
            <h2>Choose a direction.</h2>
            <p>Build a strong base before moving into more advanced technology topics.</p>

            <a class="path-row" asp-controller="Courses" asp-action="Index">
                <span class="path-number">01</span>
                <span><strong>Programming</strong><small>C#, Python and core concepts</small></span>
                <span class="path-arrow">→</span>
            </a>
            <a class="path-row" asp-controller="Courses" asp-action="Index">
                <span class="path-number">02</span>
                <span><strong>Web development</strong><small>HTML, CSS and ASP.NET Core</small></span>
                <span class="path-arrow">→</span>
            </a>
            <a class="path-row" asp-controller="Courses" asp-action="Index">
                <span class="path-number">03</span>
                <span><strong>Cybersecurity</strong><small>Networking, Linux and security</small></span>
                <span class="path-arrow">→</span>
            </a>
        </aside>
    </div>
</section>

<section class="section section-muted">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">LEARNING AREAS</span>
            <h2>Start with what you want to learn.</h2>
            <p>Browse focused technology subjects and work through them at your own pace.</p>
        </div>

        <div class="area-grid">
            <a class="area-card" asp-controller="Courses" asp-action="Index">
                <span>01</span>
                <h3>Programming</h3>
                <p>Languages, logic and object-oriented fundamentals.</p>
            </a>
            <a class="area-card" asp-controller="Courses" asp-action="Index">
                <span>02</span>
                <h3>Web development</h3>
                <p>Build interfaces and server-side web applications.</p>
            </a>
            <a class="area-card" asp-controller="Courses" asp-action="Index">
                <span>03</span>
                <h3>Cybersecurity</h3>
                <p>Understand networks, systems and defensive security concepts.</p>
            </a>
            <a class="area-card" asp-controller="Courses" asp-action="Index">
                <span>04</span>
                <h3>Databases</h3>
                <p>Learn relational data, SQL and database design.</p>
            </a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">HOW IT WORKS</span>
            <h2>A straightforward learning flow.</h2>
        </div>

        <div class="steps-grid">
            <article class="step">
                <span>01</span>
                <h3>Choose a course</h3>
                <p>Find a topic and start with the level that matches your experience.</p>
            </article>
            <article class="step">
                <span>02</span>
                <h3>Learn and practise</h3>
                <p>Work through lessons, resources and interactive assessments.</p>
            </article>
            <article class="step">
                <span>03</span>
                <h3>Track your progress</h3>
                <p>Keep your completed lessons and quiz results in one place.</p>
            </article>
        </div>
    </div>
</section>
