@{
    ViewData["Title"] = "Learn Technology";
}

<section class="hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <span class="eyebrow">TECHNOLOGY LEARNING PLATFORM</span>
            <h1>Learn to code. <span>Build what matters.</span></h1>
            <p>
                Code-Room is a practical learning platform for students who want
                structured lessons, hands-on quizzes, progress tracking and useful resources.
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Courses" asp-action="Index">Explore Courses</a>
                <a class="btn btn-secondary btn-lg" asp-controller="Home" asp-action="About">How It Works</a>
            </div>
            <div class="hero-stats">
                <div><strong>Structured</strong><small>Learning paths</small></div>
                <div><strong>Interactive</strong><small>Quizzes & progress</small></div>
                <div><strong>Practical</strong><small>Resources & lessons</small></div>
            </div>
        </div>

        <div class="hero-card">
            <div class="code-window">
                <div class="window-bar"><i></i><i></i><i></i><span>learning.cs</span></div>
                <pre><code>public class LearningPath
{
    public string Goal { get; set; }

    public void BuildSkills()
    {
        Learn();
        Practice();
        Create();
    }
}</code></pre>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">WHY CODE-ROOM</span>
            <h2>Everything students need in one place.</h2>
            <p>Lessons, multimedia resources, assessments and progress tracking are designed as one connected learning experience.</p>
        </div>

        <div class="feature-grid">
            <article class="feature-card">
                <div class="feature-icon">01</div>
                <h3>Structured Courses</h3>
                <p>Follow organised lessons from fundamentals to practical topics.</p>
            </article>
            <article class="feature-card">
                <div class="feature-icon">02</div>
                <h3>Interactive Quizzes</h3>
                <p>Test understanding and keep a record of assessment results.</p>
            </article>
            <article class="feature-card">
                <div class="feature-icon">03</div>
                <h3>Track Progress</h3>
                <p>See completed lessons and course progress from your dashboard.</p>
            </article>
        </div>
    </div>
</section>
