<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Code-Room is a structured technology learning platform for students." />
    <title>@ViewData["Title"] - Code-Room</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-updates.css" asp-append-version="true" />
</head>
<body>
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SuperAdmin);
    var displayName = isAuthenticated ? User.GetDisplayName() : string.Empty;
    var username = isAuthenticated ? (User.FindFirst("username")?.Value ?? string.Empty) : string.Empty;
    var firstName = string.IsNullOrWhiteSpace(displayName) ? "Learner" : displayName.Split(' ')[0];
    var initial = string.IsNullOrWhiteSpace(firstName) ? "C" : firstName[0].ToString().ToUpperInvariant();
}
<header class="site-header">
    <nav class="navbar container" aria-label="Primary navigation">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Code-Room home">
            <img class="logo-light" src="~/images/code-room-logo.svg" alt="Code-Room" />
            <img class="logo-dark" src="~/images/code-room-logo-dark.svg" alt="Code-Room" />
        </a>

        <div class="nav-links">
            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <a asp-area="" asp-controller="Courses" asp-action="Index">Courses</a>
            @if (isAuthenticated)
            {
                <a asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            }
            <a asp-area="" asp-controller="Home" asp-action="About">About</a>
            <a asp-area="" asp-controller="Home" asp-action="Faq">FAQ</a>
        </div>

        <div class="nav-actions">
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">☾</button>

            @if (isAuthenticated)
            {
                @await Component.InvokeAsync("NotificationBell")

                <div class="account-menu">
                    <button class="account-trigger" type="button" data-account-toggle aria-expanded="false" aria-controls="account-popover" aria-label="Open account menu" title="Account">
                        <span class="profile-avatar">@initial</span>
                    </button>
                    <div id="account-popover" class="account-popover" data-account-menu hidden>
                        <div class="account-popover-header">
                            <strong>@displayName</strong>
                            <span>@@@username</span>
                            <span class="account-role">@(isAdmin ? "Administrator" : "Student")</span>
                        </div>
                        <a asp-area="" asp-controller="Dashboard" asp-action="Index">▦&nbsp;&nbsp;Dashboard</a>
                        <a asp-area="" asp-controller="Profile" asp-action="Index">◎&nbsp;&nbsp;Profile</a>
                        <a asp-area="" asp-controller="Profile" asp-action="Settings">⚙&nbsp;&nbsp;Settings</a>
                        @if (isAdmin)
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">▤&nbsp;&nbsp;Admin Console</a>
                        }
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button class="account-danger" type="submit">↪&nbsp;&nbsp;Logout</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a class="btn btn-ghost desktop-action" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn btn-primary desktop-action" asp-area="" asp-controller="Account" asp-action="Register">Get Started</a>
            }

            <button class="mobile-toggle" type="button" data-mobile-toggle aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation">☰</button>
        </div>
    </nav>

    <div id="mobile-navigation" class="mobile-navigation" data-mobile-menu>
        <div class="container">
            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <a asp-area="" asp-controller="Courses" asp-action="Index">Courses</a>

            @if (isAuthenticated)
            {
                <a asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-area="" asp-controller="Profile" asp-action="Index">Profile</a>
                <a asp-area="" asp-controller="Profile" asp-action="Settings">Settings</a>

                @if (isAdmin)
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Console</a>
                }
            }

            <a asp-area="" asp-controller="Home" asp-action="About">About</a>
            <a asp-area="" asp-controller="Home" asp-action="Faq">FAQ</a>

            @if (!isAuthenticated)
            {
                <a asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                <a class="mobile-primary" asp-area="" asp-controller="Account" asp-action="Register">Get Started</a>
            }
        </div>
    </div>
</header>

@if (TempData["ToastTitle"] is string toastTitle)
{
    <div class="toast" data-toast role="status" aria-live="polite">
        <span class="toast-icon">@(TempData["ToastIcon"] ?? "✓")</span>
        <span class="toast-copy">
            <strong>@toastTitle</strong>
            <span>@TempData["ToastMessage"]</span>
        </span>
        <button class="toast-close" type="button" data-toast-close aria-label="Dismiss notification">×</button>
    </div>
}

<main>
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container footer-inner">
        <div class="footer-brand">
            <img class="logo-light" src="~/images/code-room-logo.svg" alt="Code-Room" />
            <img class="logo-dark" src="~/images/code-room-logo-dark.svg" alt="Code-Room" />
            <p>Learn. Code. Grow.</p>
        </div>

        <div class="footer-links">
            <div>
                <h2>Explore</h2>
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Courses" asp-action="Index">Courses</a>
            </div>

            <div>
                <h2>Information</h2>
                <a asp-area="" asp-controller="Home" asp-action="About">About</a>
                <a asp-area="" asp-controller="Home" asp-action="Faq">FAQ</a>
            </div>

            <div>
                <h2>Account</h2>
                @if (isAuthenticated)
                {
                    <form class="logout-form" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                    <a asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="container">
            <span>© @DateTime.UtcNow.Year Code-Room</span>
            <span>Web Applications Development Project</span>
            <span>All rights reserved.</span>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/ui-updates.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
