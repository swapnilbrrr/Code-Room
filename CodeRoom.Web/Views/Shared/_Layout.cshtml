<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Code-Room</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar container">
        <a class="brand" asp-controller="Home" asp-action="Index">Code-Room</a>
        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Courses" asp-action="Index">Courses</a>
            <a asp-controller="Info" asp-action="About">About</a>
            <a asp-controller="Info" asp-action="Faq">FAQ</a>
        </div>
        <div class="nav-actions">
            <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Login</a>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Get Started</a>
        </div>
    </nav>
</header>

<main>
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container footer-content">
        <span>© @DateTime.UtcNow.Year Code-Room</span>
        <span>Learn. Practice. Build.</span>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
