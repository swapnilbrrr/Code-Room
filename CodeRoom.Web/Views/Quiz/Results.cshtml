@model CodeRoom.Web.ViewModels.Quizzes.QuizResultViewModel
@{
    ViewData["Title"] = "Quiz Results";
}

<section class="page-shell">
    <div class="container result-shell">
        <div class="content-panel result-card">
            <span class="eyebrow">QUIZ COMPLETE</span>
            <h1>Quiz results</h1>
            <div class="score">@Model.Score / @Model.Total</div>
            <p>You scored @Model.Percent% on the @Model.QuizTitle.</p>
            <div class="result-actions">
                <a class="btn btn-secondary" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">Back to course</a>
                <a class="btn btn-primary" asp-controller="Student" asp-action="Index">Go to dashboard</a>
            </div>
        </div>
    </div>
</section>
