@model CodeRoom.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">WELCOME BACK</span>
        <h1>Sign in to Code-Room</h1>
        <p>Continue your learning journey.</p>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <label>Email
                <input class="input" asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </label>

            <label>Password
                <div class="password-field">
                    <input class="input" asp-for="Password" type="password" autocomplete="current-password" data-password-input />
                    <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" title="Show password"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </label>

            <label class="checkbox-row">
                <input asp-for="RememberMe" type="checkbox" />
                <span>Remember me</span>
            </label>

            <button class="btn btn-primary btn-full" type="submit">Sign in</button>
        </form>

        <p class="auth-footer">New to Code-Room? <a asp-action="Register">Create an account</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
